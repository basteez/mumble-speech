# The pinned toolchain of the Godot web build (specs/design.md §9.3.1, LD28). Read by
# scripts/godot-web/build.sh, ci.yml and release.yml. Bumping either value is a pull request that
# passes the full web test (godot-web) on every Godot version of the matrix.
RUST_NIGHTLY=nightly-2026-10-20
EMSDK_VERSION=3.1.74
# Size budget of mumble_godot.wasm in bytes (raw), enforced by check-wasm.mjs (LD34): the release
# build measured by CI (520,810 bytes, nightly-2026-10-20, Emscripten 3.1.74) plus 25 %, rounded down.
WASM_BUDGET_BYTES=651012
# Size budget of mumble_godot.threads.wasm in bytes (raw), enforced by check-wasm.mjs --threads (LD38).
# PROVISIONAL (no measurement yet): T1 replaces it with the raw size of the first CI release build plus
# 25 %, rounded down, and records the measurement in LD38 before the pull request is merged.
WASM_THREADS_BUDGET_BYTES=1000000
