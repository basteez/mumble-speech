# The pinned toolchain of the Godot web build (specs/design.md §9.3.1, LD28). Read by
# scripts/godot-web/build.sh, ci.yml and release.yml. Bumping either value is a pull request that
# passes the full web test (godot-web) on every Godot version of the matrix.
RUST_NIGHTLY=nightly-2026-10-20
EMSDK_VERSION=3.1.74
# Size budget of mumble_godot.wasm in bytes (raw), enforced by check-wasm.mjs (LD34). Provisional
# until W1 measures the release build in CI: then measured raw size + 25 %, written in LD34.
WASM_BUDGET_BYTES=12000000
