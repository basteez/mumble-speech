[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/mumble_speech/bin/libmumble_godot.so"
linux.release.x86_64 = "res://addons/mumble_speech/bin/libmumble_godot.so"
windows.debug.x86_64 = "res://addons/mumble_speech/bin/mumble_godot.dll"
windows.release.x86_64 = "res://addons/mumble_speech/bin/mumble_godot.dll"
macos.debug = "res://addons/mumble_speech/bin/libmumble_godot.dylib"
macos.release = "res://addons/mumble_speech/bin/libmumble_godot.dylib"
